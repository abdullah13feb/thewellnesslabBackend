// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id // This will be the Clerk ID
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  orders    Order[]
  cart      Cart?
}

model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  price     Float
  description String?
  image     String?
  images    String[]
  category  String?
  stock     Int      @default(0)
  
  // UI Fields
  tagline   String?
  tag       String?
  specs     Json?
  includes  Json?
  rating    Float    @default(5.0)
  reviewCount Int    @default(0)
  trustBadges Json?
  faq         Json?
  comparison  Json?
  editorial   Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String?
  category  String   @default("Uncategorized")
  author    String   @default("Admin")
  excerpt   String   @default("")
  content   String   @default("")
  image     String?
  readTime  String?
  featured  Boolean  @default(false)
  authorId  String?   // Clerk ID of the creator
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?  @unique
  guestName String?
  items     CartItem[]
  totalPrice Float   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Float
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  // Guest / Shipping Details
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  address     String
  city        String
  pincode     String
  
  items       OrderItem[]
  subtotal    Float      @default(0)
  shippingCharge Float   @default(0)
  discount    Float      @default(0)
  totalPrice  Float
  couponCode  String?
  status      String     @default("PENDING")
  paymentMethod String   @default("cod")
  paymentStatus String   @default("pending")
  stripePaymentId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([orderId, productId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discount    Float
  type        String    @default("FIXED") // FIXED or PERCENTAGE
  isActive    Boolean   @default(true)
  description String?
  expiry      DateTime?
  minPurchase Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  source        String?   // Lead Source
  status        String    @default("NEW") // Lead Status
  company       String?   // Company Name
  jobTitle      String?   // Job Title
  city          String?   // City / Location
  dynamicFields Json?     // Dynamic key-value pairs
  whatsappSent   Boolean  @default(false)
  emailSent      Boolean  @default(false)
  whatsappSentAt DateTime?
  emailSentAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LeadStatus {
  id        String   @id @default(cuid())
  label     String   @unique
  value     String   @unique
  color     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NajahForm {
  id            String   @id @default(cuid())
  formType      String   // "ANALYZE" or "CONTACT"
  name          String
  email         String
  phone         String?
  company       String?
  designation   String?
  website       String?
  analyzeSocial Boolean  @default(false)
  platforms     String[] @default([])
  platformUrls  Json?    // Stores object of { platformId: url }
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsappTemplate {
  id           String             @id @default(cuid())
  name         String
  body         String             // e.g., "Hello {{name}}, welcome to Radiant Aura Labs!"
  variables    String[]           // e.g., ["name"]
  type         String             @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT
  mediaUrl     String?            // optional attachment URL
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  campaigns    WhatsappCampaign[]
}

model WhatsappCampaign {
  id           String                      @id @default(cuid())
  name         String
  sessionId    String                      @default("default")
  batchId      String?                     // OpenWA batch ID
  templateId   String?
  template     WhatsappTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customBody   String?                     // fallback message template
  status       String                      @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, FAILED, CANCELLED
  scheduledAt  DateTime?
  totalCount   Int                         @default(0)
  successCount Int                         @default(0)
  failCount    Int                         @default(0)
  recipients   WhatsappCampaignRecipient[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model WhatsappCampaignRecipient {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  variables     Json?            // custom variables from CSV
  status        String           @default("PENDING") // PENDING, SENT, FAILED
  error         String?
  sentAt        DateTime?
}

model EmailSenderAccount {
  id        String   @id @default(cuid())
  name      String   // e.g. "Sales 1"
  email     String   @unique
  password  String   // App password
  smtpHost  String   @default("smtp.gmail.com")
  smtpPort  Int      @default(465)
  imapHost  String   @default("imap.gmail.com")
  imapPort  Int      @default(993)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentEmails EmailCampaignRecipient[]
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String?
  html      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailCampaign {
  id           String                   @id @default(cuid())
  name         String?
  subject      String
  htmlTemplate String                   @db.Text
  pdfUrl       String?                  // Stores the PDF attachment URL if provided
  status       String                   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, FAILED
  scheduledAt      DateTime?
  timezone         String?
  senderAccountIds String[]
  totalCount       Int                      @default(0)
  successCount Int                      @default(0)
  failCount    Int                      @default(0)
  openCount    Int                      @default(0)
  clickCount   Int                      @default(0)
  replyCount   Int                      @default(0)
  bounceCount  Int                      @default(0) // Track bounced counts
  spamCount    Int                      @default(0) // Track spam complaint counts
  desktopCount Int                      @default(0)
  mobileCount  Int                      @default(0)
  tabletCount  Int                      @default(0)
  smartwatchCount Int                   @default(0)
  recipients   EmailCampaignRecipient[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model EmailCampaignRecipient {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  senderAccountId String?
  senderAccount   EmailSenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  
  email           String
  name            String?
  variables       Json?          // custom variables from CSV
  status          String         @default("PENDING") // PENDING, SENT, FAILED, BOUNCED, SPAM
  error           String?
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  repliedAt       DateTime?
  bouncedAt       DateTime?      // Timestamp when bounce occurred
  spamReportedAt  DateTime?      // Timestamp when spam was reported
  deviceType      String?        // e.g. "Smartphone", "Device/Laptop", "Tablet", "Smartwatch"
}

model VisitBusiness {
  id              String   @id @default(cuid())
  placeId         String   @unique
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  website         String?
  rating          Float?
  reviewCount     Int?
  openingHours    Json?
  category        String?
  
  // Pre-Qualification AI Fields
  score           Int?
  tier            String?
  rltStatus       String?
  aiJustification String?

  visits          Visit[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Salesperson {
  id             String          @id @default(cuid())
  name           String
  whatsappNumber String
  isActive       Boolean         @default(true)
  schedules      VisitSchedule[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model VisitSchedule {
  id              String   @id @default(cuid())
  date            DateTime
  salespersonId   String?
  salesperson     Salesperson? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  startLocation   String?
  endLocation     String?
  visits          Visit[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Visit {
  id              String   @id @default(cuid())
  scheduleId      String
  schedule        VisitSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  businessId      String
  business        VisitBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderIndex      Int
  plannedTime     String?
  status          String   @default("PLANNED")
  checklistBefore Json?
  checklistDuring Json?
  checklistAfter  Json?
  notes           String?
  interestLevel   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScrapingConfig {
  id               String   @id @default(cuid())
  provider         String   @default("GOOGLE_MAPS") // "APIFY" or "GOOGLE_MAPS"
  scheduleCron     String   @default("0 0 * * *")   // Daily at midnight
  apifyToken       String?
  googleMapsApiKey String?
  isActive         Boolean  @default(false)
  searchQuery      String?  // e.g. "Spas in Dubai"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WeeklyVisitConfig {
  id              String   @id @default(cuid())
  dayOfWeek       Int      // 0 for Sunday, 1 for Monday, etc.
  targetLocation  String
  categories      String   // stored as comma-separated
  startLocation   String?
  endLocation     String?
  maxVisits       Int      @default(5)
  salespersonIds  String[] // Array of Salesperson IDs this applies to
  runTime         String   @default("00:00") // Format: "HH:mm"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
