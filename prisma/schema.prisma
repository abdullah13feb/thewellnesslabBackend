// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id // This will be the Clerk ID
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  orders    Order[]
  cart      Cart?
}

model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  price     Float
  description String?
  image     String?
  images    String[]
  category  String?
  stock     Int      @default(0)
  
  // UI Fields
  tagline   String?
  tag       String?
  specs     Json?
  includes  Json?
  rating    Float    @default(5.0)
  reviewCount Int    @default(0)
  trustBadges Json?
  faq         Json?
  comparison  Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String?
  category  String   @default("Uncategorized")
  author    String   @default("Admin")
  excerpt   String   @default("")
  content   String   @default("")
  image     String?
  readTime  String?
  featured  Boolean  @default(false)
  authorId  String?   // Clerk ID of the creator
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?  @unique
  guestName String?
  items     CartItem[]
  totalPrice Float   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Float
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  
  // Guest / Shipping Details
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  address     String
  city        String
  pincode     String
  
  items       OrderItem[]
  subtotal    Float      @default(0)
  shippingCharge Float   @default(0)
  discount    Float      @default(0)
  totalPrice  Float
  couponCode  String?
  status      String     @default("PENDING")
  paymentMethod String   @default("cod")
  paymentStatus String   @default("pending")
  stripePaymentId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([orderId, productId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discount    Float
  type        String    @default("FIXED") // FIXED or PERCENTAGE
  isActive    Boolean   @default(true)
  description String?
  expiry      DateTime?
  minPurchase Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  source        String?   // Lead Source
  status        String    @default("NEW") // Lead Status
  company       String?   // Company Name
  jobTitle      String?   // Job Title
  city          String?   // City / Location
  dynamicFields Json?     // Dynamic key-value pairs
  whatsappSent   Boolean  @default(false)
  emailSent      Boolean  @default(false)
  whatsappSentAt DateTime?
  emailSentAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LeadStatus {
  id        String   @id @default(cuid())
  label     String   @unique
  value     String   @unique
  color     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NajahForm {
  id            String   @id @default(cuid())
  formType      String   // "ANALYZE" or "CONTACT"
  name          String
  email         String
  phone         String?
  company       String?
  designation   String?
  website       String?
  analyzeSocial Boolean  @default(false)
  platforms     String[] @default([])
  platformUrls  Json?    // Stores object of { platformId: url }
  message       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsappTemplate {
  id           String             @id @default(cuid())
  name         String
  body         String             // e.g., "Hello {{name}}, welcome to Radiant Aura Labs!"
  variables    String[]           // e.g., ["name"]
  type         String             @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT
  mediaUrl     String?            // optional attachment URL
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  campaigns    WhatsappCampaign[]
}

model WhatsappCampaign {
  id           String                      @id @default(cuid())
  name         String
  sessionId    String                      @default("default")
  batchId      String?                     // OpenWA batch ID
  templateId   String?
  template     WhatsappTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customBody   String?                     // fallback message template
  status       String                      @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, FAILED, CANCELLED
  scheduledAt  DateTime?
  totalCount   Int                         @default(0)
  successCount Int                         @default(0)
  failCount    Int                         @default(0)
  recipients   WhatsappCampaignRecipient[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model WhatsappCampaignRecipient {
  id            String           @id @default(cuid())
  campaignId    String
  campaign      WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  variables     Json?            // custom variables from CSV
  status        String           @default("PENDING") // PENDING, SENT, FAILED
  error         String?
  sentAt        DateTime?
}

model EmailCampaign {
  id           String                   @id @default(cuid())
  subject      String
  htmlTemplate String                   @db.Text
  status       String                   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, FAILED
  scheduledAt  DateTime?
  timezone     String?
  totalCount   Int                      @default(0)
  successCount Int                      @default(0)
  failCount    Int                      @default(0)
  recipients   EmailCampaignRecipient[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model EmailCampaignRecipient {
  id            String         @id @default(cuid())
  campaignId    String
  campaign      EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  variables     Json?          // custom variables from CSV
  status        String         @default("PENDING") // PENDING, SENT, FAILED
  error         String?
  sentAt        DateTime?
}


