PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Paymob Payment Gateway Configuration (UAE)
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_PUBLIC_API_KEY=your_paymob_public_key
PAYMOB_PRIVATE_API_KEY=your_paymob_private_secret_key
# Comma-separated list of integration IDs (e.g. 126873 for Cards, 127586 for Google Pay, 127587 for Apple Pay)
PAYMOB_INTEGRATION_ID=126873,127586,127587
PAYMOB_IFRAME_ID=your_iframe_id_optional
PAYMOB_HMAC_SECRET=your_hmac_secret
